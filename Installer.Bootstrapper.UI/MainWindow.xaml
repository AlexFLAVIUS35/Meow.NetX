<Window x:Class="Installer.Bootstrapper.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Meow.NetX Installer"
        Height="250"
        Width="500">

    <StackPanel Margin="20">

        <TextBlock Text="Select your launcher folder"
                   FontSize="18"/>

        <StackPanel Orientation="Horizontal"
                    Margin="0,20,0,10">

            <TextBox Name="FolderBox"
                     Width="320"/>

            <Button Content="Browse"
                    Width="100"
                    Margin="10,0,0,0"
                    Click="Browse_Click"/>

        </StackPanel>

        <TextBlock Name="StatusText"
                   Text="Waiting for folder..."
                   Margin="0,10"/>

        <Button Name="InstallButton"
                Content="Install"
                Width="100"
                IsEnabled="False"
                Click="Install_Click"/>

    </StackPanel>

</Window>
